{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://your-domain.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "[Section Name, e.g. Blog]",
      "item": "https://your-domain.com/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "[Subsection, e.g. Tutorials]",
      "item": "https://your-domain.com/blog/tutorials"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "[Current Page Title]",
      "item": "https://your-domain.com/blog/tutorials/current-page"
    }
  ]
}
